generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [uuid_ossp(map: "uuid-ossp", schema: "extensions")]
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String?
  createdAt       DateTime         @default(now())
  jobApplications JobApplication[]
  notes           Note[]
  tasks           Task[]
}

model JobApplication {
  id           String    @id @default(uuid())
  userId       String
  company      String
  position     String
  platform     String
  link         String?
  status       JobStatus @default(APPLIED)
  appliedDate  DateTime  @default(now())
  followUpDate DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  hrdName      String?
  hrdEmail     String?
  hrdInstagram String?
  hrdLinkedin  String?
  salaryMin    Int?
  salaryMax    Int?
  user         User      @relation(fields: [userId], references: [id])
  logs         JobLog[]
  tasks        Task[]

  @@index([userId])
}

model JobLog {
  id        String         @id @default(dbgenerated("(gen_random_uuid())::text"))
  jobId     String
  date      DateTime?      @default(now()) @db.Timestamptz(6)
  content   String
  createdAt DateTime?      @default(now()) @db.Timestamptz(6)
  job       JobApplication @relation(fields: [jobId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([jobId], map: "job_log_job_id_idx")
}

model TaskChecklist {
  id     String  @id @default(cuid())
  taskId String
  title  String
  done   Boolean @default(false)
  order  Int
  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskAttachment {
  id        String   @id @default(cuid())
  taskId    String
  url       String
  name      String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskTag {
  id     String @id @default(cuid())
  taskId String
  label  String
  color  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Task {
  id               String           @id @default(cuid())
  userId           String
  jobApplicationId String?
  title            String
  description      String?
  status           TaskStatus       @default(TODO)
  priority         Priority         @default(MEDIUM)
  deadline         DateTime?
  estimatedDays    Int?
  isGroupProject   Boolean          @default(false)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  category         TaskCategory     @default(PERSONAL)
  notes            String?
  jobApplication   JobApplication?  @relation(fields: [jobApplicationId], references: [id])
  user             User             @relation(fields: [userId], references: [id])
  attachments      TaskAttachment[]
  checklist        TaskChecklist[]
  logs             TaskLog[]
  tags             TaskTag[]

  @@index([userId])
  @@index([jobApplicationId])
}

model TaskLog {
  id            String   @id @default(cuid())
  taskId        String
  date          DateTime @default(now())
  content       String
  lectureNumber Int?
  createdAt     DateTime @default(now())
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Note {
  id        String                 @id @default(uuid())
  userId    String
  title     String
  content   String
  tags      String[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  embedding Unsupported("vector")?
  user      User                   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([embedding], map: "note_embedding_idx")
}

enum TaskCategory {
  JOB
  LEARNING
  PERSONAL
  PROJECT
}

enum JobStatus {
  APPLIED
  INTERVIEW
  OFFER
  REJECTED
  GHOSTED
}

enum TaskStatus {
  TODO
  DOING
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
